(export (version "E")
 (design (source "interface_board_2l.kicad_sch") (tool "make_pcb.py"))
 (components
  (comp (ref "C1") (value "1000uF 10V, 10x12.5mm"))
  (comp (ref "C2") (value "10uF 10V 0805"))
  (comp (ref "C3") (value "100nF 0805"))
  (comp (ref "C4") (value "100nF 0805"))
  (comp (ref "C5") (value "100nF 0805"))
  (comp (ref "C6") (value "100nF 0805"))
  (comp (ref "J1") (value "Socket 1x15 2.54mm, ESP32 VIN row"))
  (comp (ref "J2") (value "Socket 1x15 2.54mm, ESP32 3V3 row"))
  (comp (ref "J3") (value "MIC L: 5-pin JST SM pigtail"))
  (comp (ref "J4") (value "MIC R: 5-pin JST SM pigtail"))
  (comp (ref "J5") (value "AMP: 5-pin JST SM pigtail"))
  (comp (ref "J6") (value "LED: 5-pin JST SM pigtail"))
  (comp (ref "J7") (value "5V IN: 2 wires, up to 18 AWG"))
  (comp (ref "JP1") (value "LED data: 1-2 bypass, 2-3 shifter"))
  (comp (ref "Q1") (value "AO3401A"))
  (comp (ref "R1") (value "330R 0805"))
  (comp (ref "R2") (value "100k 0805"))
  (comp (ref "R3") (value "100R 0805"))
  (comp (ref "R4") (value "100R 0805"))
  (comp (ref "U1") (value "74AHCT1G125"))
 )
 (nets
  (net (code "1") (name "+3V3") (node (ref "C4") (pin "1")) (node (ref "C5") (pin "1")) (node (ref "J2") (pin "1")) (node (ref "J3") (pin "2")) (node (ref "J4") (pin "2")))
  (net (code "2") (name "+5V") (node (ref "C1") (pin "1")) (node (ref "C2") (pin "1")) (node (ref "C3") (pin "1")) (node (ref "C6") (pin "1")) (node (ref "J1") (pin "1")) (node (ref "J5") (pin "2")) (node (ref "J6") (pin "2")) (node (ref "Q1") (pin "2")) (node (ref "U1") (pin "5")))
  (net (code "3") (name "GND") (node (ref "C1") (pin "2")) (node (ref "C2") (pin "2")) (node (ref "C3") (pin "2")) (node (ref "C4") (pin "2")) (node (ref "C5") (pin "2")) (node (ref "C6") (pin "2")) (node (ref "J1") (pin "2")) (node (ref "J2") (pin "2")) (node (ref "J3") (pin "1")) (node (ref "J4") (pin "1")) (node (ref "J5") (pin "1")) (node (ref "J6") (pin "1")) (node (ref "J7") (pin "1")) (node (ref "Q1") (pin "1")) (node (ref "R2") (pin "2")) (node (ref "U1") (pin "1")) (node (ref "U1") (pin "3")))
  (net (code "4") (name "LED_BUF") (node (ref "JP1") (pin "3")) (node (ref "U1") (pin "4")))
  (net (code "5") (name "LED_OUT") (node (ref "J6") (pin "3")) (node (ref "R1") (pin "1")))
  (net (code "6") (name "LED_RAW") (node (ref "J1") (pin "6")) (node (ref "JP1") (pin "1")) (node (ref "U1") (pin "2")))
  (net (code "7") (name "LED_SEL") (node (ref "JP1") (pin "2")) (node (ref "R1") (pin "2")))
  (net (code "8") (name "MIC_SCK") (node (ref "J3") (pin "3")) (node (ref "J4") (pin "3")) (node (ref "R4") (pin "2")))
  (net (code "9") (name "MIC_SD") (node (ref "J1") (pin "11")) (node (ref "J3") (pin "5")) (node (ref "J4") (pin "5")) (node (ref "R2") (pin "1")))
  (net (code "10") (name "MIC_WS") (node (ref "J3") (pin "4")) (node (ref "J4") (pin "4")) (node (ref "R3") (pin "2")))
  (net (code "11") (name "SCK_ESP") (node (ref "J1") (pin "10")) (node (ref "R4") (pin "1")))
  (net (code "12") (name "SPK_BCLK") (node (ref "J1") (pin "7")) (node (ref "J5") (pin "4")))
  (net (code "13") (name "SPK_DIN") (node (ref "J2") (pin "14")) (node (ref "J5") (pin "5")))
  (net (code "14") (name "SPK_LRC") (node (ref "J1") (pin "8")) (node (ref "J5") (pin "3")))
  (net (code "15") (name "VIN_RAW") (node (ref "J7") (pin "2")) (node (ref "Q1") (pin "3")))
  (net (code "16") (name "WS_ESP") (node (ref "J1") (pin "9")) (node (ref "R3") (pin "1")))
 )
)
